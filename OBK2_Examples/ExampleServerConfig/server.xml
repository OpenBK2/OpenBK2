<?xml version="1.0" encoding="UTF-8"?>
<!-- OpenBK2 lobby server example. See README.md before deployment.
     Run Server from a bin/ directory whose parent contains this file.
     The filename must be lowercase server.xml on case-sensitive filesystems. -->
<Base>
	<!-- Protocol identifier: match the clients' NetGameVersion. -->
	<NetVersion>3</NetVersion>
	<!-- IPv4 UDP lobby/relay port, bound on all local interfaces. -->
	<Port>4200</Port>

	<!-- Embedded SQLite creates its own database and schema on first start.
	     Paths are relative to the PROCESS WORKING DIRECTORY (normally bin/).
	     This path therefore stores the database beside server.xml. -->
	<DatabaseBackend>sqlite</DatabaseBackend>
	<DatabaseFile>../nivalnet.db</DatabaseFile>
	<!-- Only used with DatabaseBackend=mysql. That backend requires an existing
	     schema and uses the fixed user NivalNET with an empty password.
	     There are no XML keys for database username, password or port. -->
	<MySQLServer>127.0.0.1</MySQLServer>
	<MySQLDBName>nivalnet</MySQLDBName>

	<!-- Milliseconds without game heartbeats before a lobby game is removed.
	     These are not network ping timeouts. -->
	<GameTimeout>30000</GameTimeout>
	<!-- Additional grace period on loading: the heartbeat timestamp is moved
	     300000 ms into the future, giving 330000 ms total with GameTimeout above. -->
	<GameLoadingTimeout>300000</GameLoadingTimeout>
	<!-- Chat cleanup interval in milliseconds. -->
	<ChatSegmentLength>500</ChatSegmentLength>
	<!-- Friend-list limit; the current pre-insertion check uses greater-than,
	     so a configured value of 20 actually permits a 21st entry. -->
	<MaxFriends>20</MaxFriends>
	<!-- Server statistics are written to the database every 15 minutes. -->
	<ServerLogPeriod>900000</ServerLogPeriod>
	<!-- UTF-8 text shown on joining a chat channel; an empty element suppresses it. -->
	<Welcome>Welcome to the OpenBK2 example server!</Welcome>
	<!-- 0 skips the validcdkeys allowlist check during registration.
	     Accounts still require a non-empty CD key; use distinct keys for players.
	     1 requires populating the database's validcdkeys table first. -->
	<CheckCDKeyIsValid>0</CheckCDKeyIsValid>

	<!-- IPv4 TCP administration port. NO authentication; binds all interfaces.
	     Restrict access with a firewall/private network. 0 does NOT disable it.
	     4210 avoids the privileged ports used by the historical examples. -->
	<TerminalPort>4210</TerminalPort>

	<!-- Keep this entire block: the ladder lobby is always initialized.
	     Values and XP tables are preserved from Versions/Server/nivalnet/server.xml. -->
	<LadderConsts>
		<!-- Maximum difference between average team levels. Candidate filtering uses twice this value.
		     If increased, extend both Experience/Win and Experience/Lose key ranges too. -->
		<LevelDelta>5</LevelDelta>
		<!-- Milliseconds before accepting one unmet map/tech-level preference, then both. -->
		<WaitTime1>20000</WaitTime1>
		<WaitTime2>40000</WaitTime2>
		<!-- Upper team-size bound when a player requests any team size (0). -->
		<MaxTeamSize>4</MaxTeamSize>
		<!-- Maximum matchmaking attempts per 200 ms ladder tick; stops on the first created match. -->
		<PlayersPerStep>5</PlayersPerStep>
		<!-- Race count used for ladder statistics; keep consistent with clients and stored data. -->
		<NumberOfRaces>4</NumberOfRaces>
		<!-- Maximum reported reinforcement-vector length; the server also has a hardcoded limit of 30. -->
		<MaxUnitTypes>30</MaxUnitTypes>
		<!-- Team-assignment retry multiplier, multiplied by the candidate-player count. -->
		<MistakesPerStep>10</MistakesPerStep>
		<!-- Three medal tiers: lifetime kills must be strictly greater than each threshold. -->
		<KilledMedals>
			<Item>200</Item>
			<Item>1000</Item>
			<Item>3000</Item>
		</KilledMedals>
		<!-- Three medal tiers: last-match kills must exceed threshold times last-match losses. -->
		<KilledLostMedals>
			<Item>1.5</Item>
			<Item>3</Item>
			<Item>5</Item>
		</KilledLostMedals>
		<!-- Three medal tiers: consecutive wins must be at least each threshold. -->
		<WinsInSeriesMedals>
			<Item>3</Item>
			<Item>5</Item>
			<Item>10</Item>
		</WinsInSeriesMedals>
		<!-- Minimum level for the medal awarded to a player matching or exceeding the highest XP. -->
		<FirstPlaceMedalLevel>20</FirstPlaceMedalLevel>
		<!-- Retain complete maps and an ascending Levels list. Missing map keys yield zero. -->
		<Experience>
			<!-- Players up to and including this level receive the LossFactor multiplier on XP losses. -->
			<NewbieLevel>10</NewbieLevel>
			<!-- Key = player level; Data = multiplier on XP lost. -->
			<LossFactor>
