        MENUITEM "Key Settings",                ID_MIMOVED_KEY_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Delete keys",                 ID_MIMOVED_DELETE_KEYS
    END
END

IDM_MODEL_CONTEXT_MENU MENU 
BEGIN
    POPUP "MODEL_STATE", GRAYED
    BEGIN
        MENUITEM "Reload &Editor",              ID_MODEL_RELOAD_EDITOR
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Show &Terrain",               ID_MODEL_DRAW_TERRAIN
        , GRAYED
        MENUITEM "Show &Animations",            ID_MODEL_DRAW_ANIMATIONS
        , GRAYED
        MENUITEM "Show AI &Geometry",           ID_MODEL_DRAW_AI_GEOMETRY
        , GRAYED
        MENUITEM "Set &Light...",               ID_MODEL_SET_LIGHT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Center &Camera",              ID_MODEL_CENTER_CAMERA
        , GRAYED
        MENUITEM "&Save Camera",                ID_MODEL_SAVE_CAMERA, GRAYED
        MENUITEM "&Reset Camera",               ID_MODEL_RESET_CAMERA
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Animation Speed &Down",       ID_MODEL_SPEED_DOWN, GRAYED
        MENUITEM "Animation Speed &Up",         ID_MODEL_SPEED_UP, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Properties",                 1076, GRAYED
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// The VERSIONINFO that stood here named Nival Interactive and version 1.0.0.0.
// add_version_info() in cmake/versioninfo.cmake generates one for every module
// in this tree, and two VERSION resources in one binary is a hard error out of
// CVTRES rather than a duplicate anyone gets to choose between.


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

// IDR_ED_B2_M1_MANIFEST is 1, CREATEPROCESS_MANIFEST_RESOURCE_ID, so this
// put an application manifest in a DLL, where it means nothing, and then a
// second copy in the executable through b2_res.rc, which CVTRES rejects.
//
// What it was for is the Common-Controls 6.0 dependency that turns visual
// styles on. That is an executable's business and it is declared in
// B2_MapEditor/main.cpp now, where it can also say processorArchitecture=*
// rather than the X86 this file's manifest asks for.

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

