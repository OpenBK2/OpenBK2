@@@ shader pixel CLPointLightShadowed
ps.2.0
dcl_cube s0 ; depth map
dcl_2d s1 ; previous data
dcl_cube s2 ; normalisation map
dcl t0.xyz  ; vLight
dcl t1      ; prev mapping
dcl t2.xyz  ; vNormal
dp3_sat r0.w, t0, t0 ; r0.w = distance to point light, relative to radius (1 - on radius)
;   calc attenuation alpha
add r2.w, -r0.w, -c0.y
max r2.w, r2.w, c0.z  ; r2.w = fCut
mad r1.w, r0.w, c4.x, c4.y
rcp r1.w, r1.w
mul r1.w, r1.w, r2.w ; attenuation
;   calc (N dot L)
rsq r4.w, r0.w
mul r3.xyz, t0, r4.w ; vLight
texld r2, t2, s2
mad r2, r2, c0.x, c0.y
dp3_sat r3, r3, -r2
dp3_sat r2, r3, r2
mad r3, r2, c5, r3
;   account attenuation & light color
mul r1, r1.w, c3
mul r3, r3, r1
;   account shadow
mul r0.w, r4.w, r0.w
texld r2, t0, s0
add r0.w, r2, -r0
add r0.w, r0.w, c2.w
cmp r0, r0.w, r3, c1
;   add to previous
texldp r1, t1, s1
add r0, r0, r1
mov oC0, r0
@@@ expect
