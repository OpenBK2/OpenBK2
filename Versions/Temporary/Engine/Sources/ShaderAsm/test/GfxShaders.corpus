texld r7, r7, s1

// sample 1
add r4, r4.a, -t2.w
mad r4, r4, c7.x, -c7.w
cmp r4.rgb, r4, r0, r1
add r3.rgb, r3, r4

// sample 2
add r5, r5.a, -t2.w
mad r5, r5, c7.x, -c7.w
cmp r5.rgb, r5, r0, r1
add r3.rgb, r3, r5

// sample 3
add r6, r6.a, -t2.w
mad r6, r6, c7.x, -c7.w
cmp r6.rgb, r6, r0, r1
add r3.rgb, r3, r6

// sample 4
add r7, r7.a, -t2.w
mad r7, r7, c7.x, -c7.w
cmp r7.rgb, r7, r0, r1
add r3.rgb, r3, r7

// normalize color
mul r3.rgb, r3, c8.x
////////////////////////////////////////////////////////////////////////////////////////////////////


mad r1, v0.w, c7.y, -c7.z
add_sat r3.a, r2, r1
add r3.a, r3.a, c3.a
mul r3.a, r3.a, c7.x
////////////////////////////////////////////////////////////////////////////////////////////////////


// apply second texture
texld r2, t3, s3
mul r3, r3, r2

mov oC0, r3
@@@ expect
