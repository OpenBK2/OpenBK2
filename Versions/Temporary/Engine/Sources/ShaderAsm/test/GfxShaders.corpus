@@@ shader pixel G5DiffuseTex
ps.2.0
dcl_2d s0
dcl_2d s1
dcl t0.xy
dcl t1.xy
dcl t2.xyzw
dcl v0.xyzw
dcl v1.xyz
////////////////////////////////////////////////////////////////////////////////////////////////////


texld r2, t0, s0
mul r3, v0, r2
mul_sat r0, r3, c7.x
mul r1.rgb, v1, r2
mul_sat r1.rgb, r1, c7.x
////////////////////////////////////////////////////////////////////////////////////////////////////

texld r4, t1, s1
lrp r1.rgb, r4, r1, r0
////////////////////////////////////////////////////////////////////////////////////////////////////

add r4, r4.a, -t2.w
mad r4, r4, c7.x, -c7.w
cmp r3.rgb, r4, r0, r1

// samples
add r4.xy, c10, t1
add r5.xy, c11, t1
add r6.xy, c12, t1
add r7.xy, c13, t1

texld r4, r4, s1
texld r5, r5, s1
texld r6, r6, s1
texld r7, r7, s1

// sample 1
add r4, r4.a, -t2.w
mad r4, r4, c7.x, -c7.w
cmp r4.rgb, r4, r0, r1
add r3.rgb, r3, r4

// sample 2
add r5, r5.a, -t2.w
mad r5, r5, c7.x, -c7.w
cmp r5.rgb, r5, r0, r1
add r3.rgb, r3, r5

// sample 3
add r6, r6.a, -t2.w
mad r6, r6, c7.x, -c7.w
cmp r6.rgb, r6, r0, r1
add r3.rgb, r3, r6

// sample 4
add r7, r7.a, -t2.w
mad r7, r7, c7.x, -c7.w
cmp r7.rgb, r7, r0, r1
add r3.rgb, r3, r7

// more samples
add r4.xy, c14, t1
add r5.xy, c15, t1
add r6.xy, c16, t1
add r7.xy, c17, t1

texld r4, r4, s1
texld r5, r5, s1
texld r6, r6, s1
texld r7, r7, s1

// sample 1
add r4, r4.a, -t2.w
mad r4, r4, c7.x, -c7.w
cmp r4.rgb, r4, r0, r1
add r3.rgb, r3, r4

// sample 2
add r5, r5.a, -t2.w
mad r5, r5, c7.x, -c7.w
cmp r5.rgb, r5, r0, r1
add r3.rgb, r3, r5

// sample 3
add r6, r6.a, -t2.w
mad r6, r6, c7.x, -c7.w
cmp r6.rgb, r6, r0, r1
add r3.rgb, r3, r6

// sample 4
add r7, r7.a, -t2.w
mad r7, r7, c7.x, -c7.w
cmp r7.rgb, r7, r0, r1
add r3.rgb, r3, r7

// normalize color
mul r3.rgb, r3, c8.x
////////////////////////////////////////////////////////////////////////////////////////////////////


mov oC0, r3
