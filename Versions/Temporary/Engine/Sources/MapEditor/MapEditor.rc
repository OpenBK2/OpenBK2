/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_MAIN_CONTEXT_MENU MENU 
BEGIN
    POPUP "DW_GDB_BROWSER"
    BEGIN
        MENUITEM "Select &Tables",              ID_MAIN_SELECT, GRAYED
        MENUITEM "&Refresh Tables",             ID_MAIN_RELOAD, GRAYED
        MENUITEM "Save A&ll Tables",            ID_MAIN_SAVE, GRAYED
        MENUITEM "Register &XDB...",           ID_MAIN_REGISTER_XDB
    END
    POPUP "TREE_GDB_BROWSER"
    BEGIN
        MENUITEM "GET_LABEL",                   ID_OBJECT_LOAD, GRAYED
        MENUITEM "List &References...",         ID_OBJECT_REF_LOOKUP, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "New &Folder",                 ID_OBJECT_NEW_FOLDER, GRAYED
        MENUITEM "&New Object",                 ID_OBJECT_NEW, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "New Root F&older",            ID_OBJECT_NEW_FOLDER_AT_ROOT
        , GRAYED
        MENUITEM "Ne&w Root Object",            ID_OBJECT_NEW_AT_ROOT
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        ID_SELECTION_CUT, GRAYED
        MENUITEM "&Copy",                       ID_SELECTION_COPY, GRAYED
        MENUITEM "&Paste",                      ID_SELECTION_PASTE, GRAYED
        MENUITEM "&Delete",                     ID_SELECTION_CLEAR, GRAYED
        MENUITEM "Rena&me",                     ID_SELECTION_RENAME, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Select &All",                 ID_SELECTION_SELECT_ALL
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Export",                     ID_OBJECT_EXPORT_NO_REF
        , GRAYED
        MENUITEM "Force E&xport",               ID_OBJECT_EXPORT_NO_REF_FORCE
        , GRAYED
        POPUP "Hierarchical Export"
        BEGIN
            MENUITEM "C&heck",                      ID_OBJECT_CHECK, GRAYED
            MENUITEM "&Export",                     ID_OBJECT_EXPORT, GRAYED
            MENUITEM "Force E&xport",               ID_OBJECT_EXPORT_FORCE
            , GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "&Find...",                    ID_SELECTION_FIND, GRAYED
    END
END

