---
# One style for the whole tree, applied to whole files.
#
# The goal is code that is easy to read, easy to maintain and hard to make a
# mistake in. Matching what was already there is not a goal: where the two
# disagreed, this file follows the first. That is why a line here can differ
# from the line a 2005 author wrote, and why the diff that introduced this
# config is large.
#
# Enforced on every source by .pre-commit-config.yaml before a commit, and again
# by .github/workflows/hygiene.yml. Not applied to generated sources, the
# parser's fixture corpus or third-party code; see "file hygiene" in
# Contributing.md for the list and the reasons.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17

# A tab is two columns, as .editorconfig also declares, and indentation is tabs
# while alignment is spaces. dbcodegen's generated sources indent with tabs too.
UseTab: AlignWithSpaces
TabWidth: 2
IndentWidth: 2
AccessModifierOffset: -2

# A continuation is indented deeper than a nesting level, so a wrapped line
# cannot be mistaken for the start of a block.
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4

# A braced list's elements sit one level in from the declaration, not two: they
# are the contents of the braces rather than the continuation of a statement.
BracedInitializerIndentWidth: 2

# Wide enough for this code, which carries long type and member names, and
# narrow enough to read without scrolling and to put two files side by side.
# Comments are exempt: ReflowComments below leaves them alone.
ColumnLimit: 120

# A wrapped line lines up under what it continues, which is what makes a long
# argument list or condition readable once it no longer fits on one line.
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignEscapedNewlines: Left
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# void Foo( int n ) and if ( x ), as the tree writes them. A C-style cast keeps
# its tight parentheses: (std::min)( a, b ), (int)x.
SpaceBeforeParens: ControlStatements
SpacesInParens: Custom
SpacesInParensOptions:
  InConditionalStatements: true
  InCStyleCasts: false
  InEmptyParentheses: false
  Other: true
SpacesInSquareBrackets: false

# Braced lists are laid out like a call, which is what lets a long one go one
# element per line (see BinPackLongBracedList below); Block keeps packing them
# into columns however many fit. The spacing is unaffected: SpacesInParens
# above applies to a braced list in this mode too, so it stays { 1, 2 }.
Cpp11BracedListStyle: FunctionCall

BreakBeforeBraces: Allman
PointerAlignment: Right
ReferenceAlignment: Right
DerivePointerAlignment: false

# Every control statement gets braces, inserted if they are missing. This is
# the one setting here that changes code rather than layout, and it is the
# point: a braceless body is how Apple shipped "goto fail", and a statement
# added later that silently falls outside the condition is the easiest mistake
# to make in this language. The house rule already required braces on anything
# new; this applies it to everything and keeps it applied.
InsertBraces: true

# One statement per line. A body on the same line as its condition hides the
# second statement somebody adds later, and hides which branch a line belongs
# to when reading quickly.
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# One enumerator per line, so adding or removing one is a one-line diff and
# shows up in blame against the line it belongs to.
AllowShortEnumsOnASingleLine: false

# A signature goes on its own line and its body below it, accessors included:
# `int GetID() const { return nID; }` becomes four lines. LLVM and Google both
# keep that on one line, and it is the one place their answer was rejected on
# purpose. A one-line body hides where the function ends, and reading a header
# means reading a column of signatures, not picking them out of a line each.
#
# Empty rather than None, so a constructor or an interface stub with nothing in
# it stays `CThing() {}` instead of spending three lines saying nothing.
AllowShortFunctionsOnASingleLine: Empty

# The template header goes on its own line, so the signature below it reads the
# same whether or not the function happens to be a template.
BreakTemplateDeclarations: Yes

# Case labels are indented inside their switch, so a label reads as part of the
# block it is in rather than as a sibling of the switch.
IndentCaseLabels: true

# A namespace at file scope does not indent its contents, since nearly every
# line in the file would pay for it; a namespace nested in one does.
NamespaceIndentation: Inner

# Include order is load-bearing. stdafx.h must come first, and several headers
# name types an earlier include has to have declared, so sorting them breaks the
# build rather than the layout. Using declarations are left in their order for
# the same reason: a formatter reordering declarations is not a layout change.
SortIncludes: Never
SortUsingDeclarations: Never

# A message that does not fit the column limit stays one string. Splitting it
# into adjacent literals means the same thing to the compiler, but it is the one
# thing here that would make the code harder to work with rather than easier:
# half of these are log lines, SQL and UI text, and a split one can no longer be
# found by searching for what the program printed.
BreakStringLiterals: false

# Comments carry Russian text, box drawing, aligned tables and quoted Intel
# pseudocode, none of which survives being rewrapped.
ReflowComments: Never

# A closing brace at the end of a long file says which namespace it closes:
# `} // namespace NGfx`. The files here run to thousands of lines and nest
# namespaces, so the alternative is counting braces. LLVM and Google both do
# this.
FixNamespaceComments: true

# A blank line between definitions, which is what makes a function's start and
# end visible without counting braces. Both LLVM and Google leave this to the
# author, and leaving it to the author is how this tree ended up with screens of
# definitions packed edge to edge.
SeparateDefinitionBlocks: Always

# One per line, once it does not fit on one line: arguments, parameters and the
# elements of a braced list. A packed block of values is dense to read, and an
# added or removed element rewrites every line after it, where one per line
# makes it a one-line diff against the line that changed.
#
# BinPackLongBracedList is what extends this to the long arrays and enums,
# which clang-format otherwise packs into columns however many fit. That is the
# shape most of this tree's tables want. The four that genuinely want a grid
# are wrapped in clang-format off: the sine and arcsine tables in
# System/FastMath.cpp, the bit mask table in System/BitStreams.cpp and the
# embedded cursor in MapEditorLib/CursorsWx.cpp.
BinPackArguments: false
BinPackParameters: OnePerLine
BinPackLongBracedList: false

# Left alone: aligning a run of assignments reads well in a table and badly
# everywhere else, and it makes renaming one identifier rewrite the whitespace
# of every line around it.
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
IndentPPDirectives: None
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 1
InsertNewlineAtEOF: true
