# The map files the map records in the data tree are missing.
#
# A mission is two files, and this repository keeps them apart. The record,
# <name>/MapInfo.xdb, is in the data tree under Versions/Current/Data, which is
# copied into an install by hand. The terrain it is played on, map.b2m, is under
# Complete instead, in the layout each record still names in its MapFilesPath
# field, and nothing copies that half. The game reads the terrain out of the
# folder the record itself is in (NDb::GetFolderName), so those missions arrive
# in an install without a map: all fourteen under Custom/Missions and most of
# the test maps under Test/TestMaps. The game refuses such a mission with a
# message rather than crashing on it, which leaves the custom mission screen
# empty and every test map unusable.
#
# Installing the maps beside their records is the whole fix, and it is here so
# that building and installing is enough to have missions to test a change on.
# Into Data, like cmake/fontpak.cmake: an install prefix with its own copy of
# Data gets its own copy of these, and the usual Linux arrangement, where Data
# is a symlink to the source tree, gets them written through it into the tree.
# Either way that is where the VFS reads them from.
#
# cmake/testmaps.list is the pairing, generated by scripts/gen_testmaps_list.py
# from each record's own MapFilesPath, not by matching folder names. It is a
# list and not a glob for the reason every file list in this tree is, and it is
# generated because there are several hundred of them.
#
# This is 130 MB or so of maps. Default on, because a developer who has the
# repository has the maps and the point is not having to copy them; CI turns it
# off, having neither Complete in its sparse checkout nor any use for a map.
option(INSTALL_TEST_MAPS "Install the map files the map records in the data tree need" ON)

if(NOT INSTALL_TEST_MAPS)
    return()
endif()

set(OBK2_TEST_MAP_LIST "${CMAKE_SOURCE_DIR}/cmake/testmaps.list")
if(NOT EXISTS "${OBK2_TEST_MAP_LIST}")
    message(WARNING "no ${OBK2_TEST_MAP_LIST}: no custom-mission or test maps will be installed")
    return()
endif()

# Reconfigure when the list changes, as a generated input should.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${OBK2_TEST_MAP_LIST}")

file(STRINGS "${OBK2_TEST_MAP_LIST}" OBK2_TEST_MAP_LINES ENCODING UTF-8)
set(OBK2_TEST_MAPS_MISSING 0)
foreach(OBK2_TEST_MAP_LINE IN LISTS OBK2_TEST_MAP_LINES)
    if(OBK2_TEST_MAP_LINE MATCHES "^#" OR OBK2_TEST_MAP_LINE STREQUAL "")
        continue()
    endif()
    # <destination folder under Data>|<map file, relative to the source tree>
    string(REGEX REPLACE "\\|.*$" "" OBK2_TEST_MAP_DESTINATION "${OBK2_TEST_MAP_LINE}")
    string(REGEX REPLACE "^[^|]*\\|" "" OBK2_TEST_MAP_SOURCE "${OBK2_TEST_MAP_LINE}")
    if(OBK2_TEST_MAP_DESTINATION STREQUAL "" OR OBK2_TEST_MAP_SOURCE STREQUAL "")
        message(FATAL_ERROR "testmaps.list: cannot read the line \"${OBK2_TEST_MAP_LINE}\"")
    endif()
    # A sparse checkout, as CI's is, has the records without the maps. Counted
    # rather than fatal: the engine builds and runs without them.
    if(EXISTS "${CMAKE_SOURCE_DIR}/${OBK2_TEST_MAP_SOURCE}")
        install(FILES "${CMAKE_SOURCE_DIR}/${OBK2_TEST_MAP_SOURCE}"
                DESTINATION "Data/${OBK2_TEST_MAP_DESTINATION}")
    else()
        math(EXPR OBK2_TEST_MAPS_MISSING "${OBK2_TEST_MAPS_MISSING} + 1")
    endif()
endforeach()

if(OBK2_TEST_MAPS_MISSING GREATER 0)
    message(WARNING "${OBK2_TEST_MAPS_MISSING} maps in testmaps.list are not in this checkout and will not be installed")
endif()
